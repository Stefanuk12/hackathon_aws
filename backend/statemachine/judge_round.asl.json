{
  "Comment": "Judge a round: rank drawings, voice the host, save + publish results. Input: {code, round}",
  "StartAt": "Judge",
  "States": {
    "Judge": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${JudgeFunctionArn}", "Payload.$": "$" },
      "ResultSelector": { "results.$": "$.Payload.results", "references.$": "$.Payload.references" },
      "ResultPath": "$.judge",
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 2, "MaxAttempts": 2, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.judgeError", "Next": "JudgeFailed" }],
      "Next": "HostVoice"
    },
    "JudgeFailed": {
      "Comment": "Bedrock kept failing: finish the round with no ranking rather than leave the room stuck in judging.",
      "Type": "Pass",
      "Result": { "results": [], "references": [] },
      "ResultPath": "$.judge",
      "Next": "SaveResults"
    },
    "HostVoice": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${HostVoiceFunctionArn}", "Payload.$": "$" },
      "ResultSelector": { "audioUrl.$": "$.Payload.audioUrl", "script.$": "$.Payload.script" },
      "ResultPath": "$.voice",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.voiceError", "Next": "SaveResults" }],
      "Next": "SaveResults"
    },
    "SaveResults": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${SaveResultsFunctionArn}", "Payload.$": "$" },
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 3, "BackoffRate": 2 }],
      "End": true
    }
  }
}
